{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maple-updates",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "updates.trymaple.ai",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
