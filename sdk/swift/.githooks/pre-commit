#!/bin/sh
# The orchestrator enters the root Apple shell. Xcode supplies Swift and its
# formatter; this hook neither starts services nor runs hosted checks.
set -u
. "${MAPLE_HOOK_REPO_ROOT:?}/.githooks/lib/common.sh"
hook_require xcrun
hook_run bash "$MAPLE_HOOK_REPO_ROOT/scripts/ci/sdk-swift.sh" unit
