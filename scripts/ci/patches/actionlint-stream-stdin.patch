+package actionlint
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/execabs"
+)
+
+func TestCmdExecutionStreamsLargeStdin(t *testing.T) {
+	cat, err := execabs.LookPath("cat")
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload := strings.Repeat("large stdin regression\n", 16384)
+	for _, combined := range []bool{false, true} {
+		t.Run(map[bool]string{false: "stdout", true: "combined"}[combined], func(t *testing.T) {
+			done := make(chan error, 1)
+			go func() {
+				output, err := (&cmdExecution{cat, nil, payload, combined}).run()
+				if err == nil && string(output) != payload {
+					err = fmt.Errorf("stdin content did not round-trip")
+				}
+				done <- err
+			}()
+			select {
+			case err := <-done:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(10 * time.Second):
+				t.Fatal("child did not consume stdin larger than a pipe buffer")
+			}
+		})
+	}
+}
